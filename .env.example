# ── HQG Platform — environment configuration ──────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Application ───────────────────────────────────────────────────────
APP_NAME=HQG Web Security Platform
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1

# ── CORS ──────────────────────────────────────────────────────────────
# Add your VPS public IP or domain.  The frontend origin must be listed.
# Comma-separated list of allowed origins.
# Example: http://203.0.113.10:3000,https://hqg.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Redis (set automatically by docker-compose via environment:) ──────
# Do NOT change these unless you run Redis externally.
REDIS_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1

# ── Celery ────────────────────────────────────────────────────────────
CELERY_TASK_DEFAULT_QUEUE=queue_default

# ── Optional: NVD API key ─────────────────────────────────────────────
# Free key for 50 req/30s instead of 5 req/30s:
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── Optional: Elasticsearch ───────────────────────────────────────────
# Leave empty to disable search features (app starts fine without it).
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ── Optional: PostgreSQL ──────────────────────────────────────────────
# Leave empty if not using database features.
POSTGRES_DSN=
