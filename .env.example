# ── HQG Platform — environment configuration ──────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Application ───────────────────────────────────────────────────────
APP_NAME=HQG Web Security Platform
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1

# ── JWT Secret (REQUIRED) ──────────────────────────────────────────────
# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: If not set, a random ephemeral key is generated per restart
# and all tokens are invalidated on every restart.
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# ── Admin credentials (first-run seeding) ─────────────────────────────
# Only used when no users exist in Redis (first startup).
# After first run, change password via /api/v1/auth/change-password.
HQG_ADMIN_USERNAME=admin
HQG_ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Must include the exact URL users access the frontend from.
# Example: http://203.0.113.10:3000,https://hqg.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Redis (set automatically by docker-compose via environment:) ──────
REDIS_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1

# ── Celery ────────────────────────────────────────────────────────────
CELERY_TASK_DEFAULT_QUEUE=queue_default

# ── Optional: NVD API key ─────────────────────────────────────────────
# Free key: https://nvd.nist.gov/developers/request-an-api-key
# Without key: 5 req/30s limit. With key: 50 req/30s.
NVD_API_KEY=

# ── Optional: Elasticsearch ───────────────────────────────────────────
# Leave empty to disable (app starts fine without it).
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ── Optional: PostgreSQL ──────────────────────────────────────────────
POSTGRES_DSN=
