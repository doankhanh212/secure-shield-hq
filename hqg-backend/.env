APP_NAME=HQG Web Security Platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1

# Redis — localhost for local development
REDIS_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND=redis://localhost:6379/1

# Elasticsearch (optional — app starts without it)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Postgres (optional — only needed if DB features are used)
POSTGRES_DSN=postgresql+asyncpg://hqg:hqg@localhost:5432/hqg

CELERY_TASK_DEFAULT_QUEUE=queue_default
