APP_NAME=HQG Web Security Platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1

# Redis — uses the compose service name
REDIS_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1

# Elasticsearch disabled in compose (optional)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Postgres disabled in compose (optional)
POSTGRES_DSN=postgresql+asyncpg://hqg:hqg@postgres:5432/hqg

CELERY_TASK_DEFAULT_QUEUE=queue_default

# NVD API Key (optional — leave empty for public rate limit 5 req/30s)
NVD_API_KEY=
